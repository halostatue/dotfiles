#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/inline"

gemfile do
  source "https://rubygems.org"
  gem "octokit"
  gem "faraday-retry"
end

require "erb"
require "json"
require "open3"
require "optparse"
require "uri"

class RepoTool
  RESOURCES = {
    settings: {type: :hash, desc: "General settings", default: true},
    rulesets: {type: :array, desc: "Branch and tag rule sets", default: true},
    labels: {type: :array, desc: "Issue and pull-request labels", default: true},
    topics: {type: :replace, desc: "Topics", default: true},
    autolinks: {type: :array, desc: "Auto-linked text patterns", default: true},
    actions_permissions: {type: :hash, desc: "Permissions for actions", default: true},
    actions_variables: {type: :array, desc: "Variables defined for actions", default: true},
    collaborators: {type: :hash, desc: "Collaborators on the repo with permissions level", default: false},
    environments: {type: :array, desc: "Environments with variables and defined secrets", default: false}
  }.freeze

  ALL_RESOURCES = RESOURCES.keys.freeze
  DEFAULT_RESOURCES = RESOURCES.select { |_, meta| meta[:default] }.keys.freeze
  RESOURCE_KIND = RESOURCES.transform_values { it[:type] }.freeze

  # has_discussions is handled separately (see fetch_has_discussions /
  # apply_has_discussions) -- it has no REST field, only a GraphQL mutation.
  # has_pages and has_downloads are deliberately omitted: has_pages needs a
  # build type + source (a new resource, not a settings field) and
  # has_downloads is a defunct legacy field with no write support anywhere.
  SETTINGS_FIELDS = %i[
    has_issues has_projects has_wiki
    is_template allow_forking allow_squash_merge allow_merge_commit
    allow_rebase_merge allow_auto_merge delete_branch_on_merge
    allow_update_branch use_squash_pr_title_as_default
    squash_merge_commit_message squash_merge_commit_title
    merge_commit_message merge_commit_title security_and_analysis
    has_pull_requests pull_request_creation_policy web_commit_signoff_required
  ].freeze

  RULESET_FIELDS = %i[name target enforcement bypass_actors conditions rules].freeze

  PERMISSION_RANK = %i[pull triage push maintain admin].freeze

  def run(argv)
    mode, *rest = argv
    usage(1) if mode.nil?

    case mode
    when "copy" then mode_copy(rest)
    when "save" then mode_save(rest)
    when "apply" then mode_apply(rest)
    when "merge" then mode_merge(rest) # undocumented -- see usage()
    when "-?", "-h", "--help", "help" then usage(0)
    else usage(1)
    end
  end

  private

  def bn0
    @bn0 ||= File.basename($PROGRAM_NAME)
  end

  def resource_listing
    width = RESOURCES.keys.map { it.to_s.length }.max

    RESOURCES.map do |name, meta|
      tag = meta[:default] ? "" : " *"
      "  #{name.to_s.ljust(width)}  #{meta[:desc]}#{tag}"
    end.join("\n") + "\n\n  * Excluded by default, use --only or --include."
  end

  def usage(code)
    puts <<~USAGE
      Usage: #{bn0} MODE [OPTIONS] ARGS...

      Work with settings and resources on a GitHub repo.

      Modes:
        copy [OPTIONS] [SOURCE] TARGET    Copy from SOURCE to TARGET repo
        save [OPTIONS] [SOURCE] [FILE]    Save from SOURCE repo to FILE
        apply [OPTIONS] [TARGET] FILE...  Apply from FILE(s) to TARGET repo

      OPTIONS:
        -q, --quiet             Suppress routine progress output (all modes)
        -r, --remote=NAME       Use this remote when resolving '.' (all modes)
        -o, --only=RES,RES      Handle only these resources (copy/apply); not combinable with -x/-i
        -x, --except=RES,RES    Handle the default resources except these (copy/apply); 'all' for every
                                resource; wins over --include on overlap
        -i, --include=RES,RES   Handle the default resources plus these (copy/apply); 'all' for every resource

      RESOURCES:
      #{resource_listing}

      Rulesets include an equivalent ruleset migrated (read-only) from classic
      default-branch protection, if the branch has any.

      SOURCE/TARGET default to the repo in the current directory when omitted,
      and may be given as a local git directory (resolved via gh) or an owner/repo
      string.

      The default FILENAME is '{owner}-{repo}.json'.

      Examples:
        #{bn0} copy halostatue/source halostatue/target
        #{bn0} copy --except=topics ../source .
        #{bn0} save halostatue/source
        #{bn0} apply --only=labels,topics halostatue/target base.json overrides.json
        #{bn0} copy --include=collaborators halostatue/source halostatue/target
        #{bn0} apply --include=all --except=rulesets halostatue/target base.json
    USAGE

    exit code
  end

  # -- GitHub client -------------------------------------------------------

  def which(cmd)
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |dir|
      path = File.join(dir, cmd)
      return path if File.file?(path) && File.executable?(path)
    end

    nil
  end

  def gh_available?
    return @gh_available unless @gh_available.nil?

    @gh_available = !which("gh").nil?
  end

  def env_token
    [ENV["GH_TOKEN"], ENV["GITHUB_TOKEN"]].find { it && !it.empty? }
  end

  def gh_token
    abort "Error: no GH_TOKEN/GITHUB_TOKEN set and 'gh' is not installed" unless gh_available?

    output, status = Open3.capture2e("gh", "auth", "token")
    abort "Error: failed to get gh auth token (#{output.strip})" unless status.success?

    output.strip
  end

  def client
    @client ||= Octokit::Client.new(access_token: env_token || gh_token, auto_paginate: true)
  end

  def deep_to_h(obj)
    case obj
    when Sawyer::Resource
      obj.to_h.transform_values { deep_to_h(it) }
    when Hash
      obj.transform_values { deep_to_h(it) }
    when Array
      obj.map { deep_to_h(it) }
    else
      obj
    end
  end

  def get(path, params = {}) = deep_to_h(client.get(path, params))

  # has_discussions has no REST field -- GraphQL's updateRepository mutation
  # is the only way to read/write it. String keys, not symbols: Octokit's
  # Connection#request special-cases a symbol :query key on the data hash as
  # "URL query params" and strips it out before building the body -- which
  # collides with GraphQL's own required "query" field.
  def graphql(query, variables = {})
    result = deep_to_h(client.post("graphql", {"query" => query, "variables" => variables}))
    abort "Error: GraphQL request failed: #{result[:errors].map { it[:message] }.join("; ")}" if result[:errors]

    result[:data]
  end

  # For URL *path segments* -- unlike URI.encode_www_form_component (which
  # encodes spaces as "+", meant for query strings/form bodies), this encodes
  # spaces as "%20" the way a path segment needs.
  def path_escape(str) = ERB::Util.url_encode(str)

  # -- repo resolution -------------------------------------------------------

  def repo_name_from_gh
    output, status = Open3.capture2e("gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner")
    return nil unless status.success?

    name = output.strip
    name.empty? ? nil : name
  end

  # Fallback for when `gh` isn't installed, or (see repo_name_from_local_dir)
  # when it's installed but can't tell which remote is "the" repo. Only
  # handles the two remote URL shapes that matter:
  # https?://host/.../owner/repo(.git)? and [user@]host:owner/repo(.git)?
  # (scp-like syntax, including custom SSH config Host aliases in place of a
  # real hostname). Doesn't resolve SSH aliases to a real host the way `gh`
  # does -- it doesn't need to, since owner/repo is just the last two path
  # segments regardless of what the host portion says.
  def parse_owner_repo(url)
    parts = url.strip.delete_suffix(".git").split(%r{[:/]}).reject(&:empty?)
    parts.last(2).join("/") if parts.length >= 2
  end

  # @remote (set via -r/--remote) pins this to a single named remote --
  # otherwise tries origin, then upstream.
  def repo_name_from_local_git
    remotes = @remote ? [@remote] : %w[origin upstream]

    remotes.each do |remote|
      output, status = Open3.capture2e("git", "remote", "get-url", remote)
      next unless status.success?

      parsed = parse_owner_repo(output)
      return parsed if parsed
    end

    nil
  end

  # -r/--remote forces the local-git path (gh has no way to pick a specific
  # remote), and gh failing -- e.g. it can't disambiguate multiple remotes --
  # falls through to local git instead of a hard failure.
  def repo_name_from_local_dir
    return repo_name_from_local_git if @remote

    (gh_available? && repo_name_from_gh) || repo_name_from_local_git
  end

  def resolve_repo(arg)
    if File.exist?(arg)
      return nil unless File.directory?(File.join(arg, ".git"))

      Dir.chdir(arg) { repo_name_from_local_dir }
    elsif !arg.start_with?(".", "/") && arg.count("/") == 1
      arg
    end
  end

  def require_repo(arg)
    resolve_repo(arg) || abort("Error: '#{arg}' is not a git directory (with a GitHub remote) or an owner/repo string")
  end

  # stderr, not stdout -- stdout is reserved for actual data (the JSON when
  # FILE is "-"), so progress narration can never corrupt a piped output.
  def log(msg)
    warn msg unless @quiet
  end

  # -q and -r are accepted by all modes; -o/-x/-i (added by
  # extract_resource_filter) only make sense for copy/apply/merge.
  def base_option_parser
    OptionParser.new do |opts|
      opts.on("-q", "--quiet", "Suppress routine progress output") { @quiet = true }
      opts.on("-r", "--remote=NAME", "Use this remote when resolving '.' (default: origin, then upstream)") { |v| @remote = v }
    end
  end

  def parse_options!(args)
    args = args.dup
    base_option_parser.parse!(args)
    args
  rescue OptionParser::ParseError => e
    abort "Error: #{e.message}"
  end

  # "all" in a --except/--include list expands to every resource, so
  # --include=all doesn't require spelling out every opt-in resource. --only
  # doesn't get this -- it's meant for spelling out a specific short list.
  def expand_all(list)
    list.map(&:to_sym).flat_map { |r| (r == :all) ? ALL_RESOURCES : [r] }.uniq
  end

  # --except always wins over --include on overlap (it's the more specific,
  # more recently-stated ask), and --only is exclusive of both -- "only X"
  # and "everything plus/minus Y" don't compose.
  def select_resources(only:, except:, include:)
    selected =
      if only
        ALL_RESOURCES & only
      else
        (DEFAULT_RESOURCES | (include || [])) - (except || [])
      end

    abort "Error: no resources selected" if selected.empty?

    selected
  end

  # copy/apply/merge -- decides what gets *applied* (or merged), never what
  # gets fetched (collect always fetches everything; see collect below).
  # Yields the parser before parsing so callers (mode_merge) can add more
  # options onto the same pass.
  def extract_resource_filter(args)
    args = args.dup
    only = except = include = nil

    parser = base_option_parser
    parser.on("-o", "--only=RES,RES", Array, "Handle only these resources (not combinable with --include/--except)") { |list| only = list.map(&:to_sym) }
    parser.on("-x", "--except=RES,RES", Array, "Handle the default resources except these ('all' for every resource); wins over --include") { |list| except = expand_all(list) }
    parser.on("-i", "--include=RES,RES", Array, "Handle the default resources plus these ('all' for every resource)") { |list| include = expand_all(list) }

    yield parser if block_given?

    begin
      parser.parse!(args)
    rescue OptionParser::ParseError => e
      abort "Error: #{e.message}"
    end

    abort "Error: --only cannot be combined with --include or --except" if only && (except || include)

    unknown = ((only || []) + (except || []) + (include || [])) - ALL_RESOURCES
    abort "Error: unknown resource(s) #{unknown.join(", ")} (known: #{ALL_RESOURCES.join(", ")})" unless unknown.empty?

    [args, select_resources(only:, except:, include:)]
  end

  # Always fetches every resource, regardless of --only/--except/--include --
  # those only ever filter what gets applied/written, never what gets read.
  def collect(repo)
    ALL_RESOURCES.each_with_object({}) do |res, acc|
      log "Fetching #{res} from #{repo}..."
      acc[res] = send(:"fetch_#{res}", repo)
    end
  end

  # FILE may be "-" to mean stdin.
  def read_json_source(file)
    content =
      if file == "-"
        log "Loading from stdin..."
        $stdin.read
      else
        abort "Error: #{file} not found" unless File.file?(file)
        log "Loading #{file}..."
        File.read(file)
      end

    JSON.parse(content, symbolize_names: true)
  rescue JSON::ParserError => e
    abort "Error: invalid JSON in #{file}: #{e.message}"
  end

  # -- shared apply/merge machinery ---------------------------------------------
  #
  # `merge` (undocumented -- see run()) is the logical equivalent of applying
  # `apply base o1 o2 o3` multiple times: same skeleton, same per-file merge,
  # same branch_protection conversion, just printed instead of sent to a repo.

  def merge_skeleton(resources)
    RESOURCE_KIND.slice(*resources).to_h { |res, kind| [res, (kind == :hash) ? {} : []] }
  end

  def merge_resource!(combined, res, value)
    combined[res] =
      case RESOURCE_KIND[res]
      when :hash then deep_merge(combined[res], value)
      when :replace then value # e.g. topics: the API PUTs the whole list, so later files replace, not append
      else combined[res] + value # rulesets/labels/autolinks/actions_variables/environments: additive, one API call per item
      end
  end

  # {branch_protection: {"<branch>": {<raw classic-protection API shape>}}} in
  # a file converts each entry to a ruleset via ruleset_from_branch_protection
  # (which is pure -- no API calls -- so this works fine against pasted JSON).
  def merge_branch_protection!(combined, context, data)
    return unless combined.key?(:rulesets)

    (data[:branch_protection] || {}).each do |branch, protection|
      ruleset = ruleset_from_branch_protection(context, branch.to_s, protection)
      combined[:rulesets] << ruleset if ruleset
    end
  end

  def merge_file_into!(combined, file)
    data = read_json_source(file)

    combined.each_key do |res|
      value = data[res]
      merge_resource!(combined, res, value) unless value.nil?
    end

    merge_branch_protection!(combined, file, data)
  end

  def resolve_from_to(args)
    usage(1) if args.empty? || args.length > 2

    if args.length == 1
      [require_repo("."), require_repo(args[0])]
    else
      [require_repo(args[0]), require_repo(args[1])]
    end
  end

  def repo_org(repo) = repo.split("/", 2).first

  def highest_permission(perms)
    return "pull" unless perms

    (PERMISSION_RANK.rfind { perms[it] } || :pull).to_s
  end

  def deep_merge(a, b)
    a.merge(b) { |_, av, bv| (av.is_a?(Hash) && bv.is_a?(Hash)) ? deep_merge(av, bv) : bv }
  end

  # -- settings --------------------------------------------------------------

  def fetch_settings(repo)
    settings = get("repos/#{repo}").slice(*SETTINGS_FIELDS)
    settings[:has_discussions] = fetch_has_discussions(repo)
    settings
  rescue Octokit::Error => e
    abort "Error: failed to fetch settings from #{repo}: #{e.message}"
  end

  def apply_settings(repo, settings)
    settings = settings.dup
    has_discussions = settings.delete(:has_discussions)

    log "Applying settings to #{repo}..."
    client.patch("repos/#{repo}", settings)
    apply_has_discussions(repo, has_discussions) unless has_discussions.nil?
  rescue Octokit::Error => e
    abort "Error: failed to apply settings to #{repo}: #{e.message}"
  end

  def fetch_has_discussions(repo)
    owner, name = repo.split("/", 2)
    query = <<~GRAPHQL
      query($owner: String!, $name: String!) {
        repository(owner: $owner, name: $name) { hasDiscussionsEnabled }
      }
    GRAPHQL

    graphql(query, owner:, name:).dig(:repository, :hasDiscussionsEnabled)
  end

  def apply_has_discussions(repo, enabled)
    owner, name = repo.split("/", 2)
    id_query = <<~GRAPHQL
      query($owner: String!, $name: String!) {
        repository(owner: $owner, name: $name) { id }
      }
    GRAPHQL
    node_id = graphql(id_query, owner:, name:).dig(:repository, :id)

    mutation = <<~GRAPHQL
      mutation($id: ID!, $enabled: Boolean!) {
        updateRepository(input: {repositoryId: $id, hasDiscussionsEnabled: $enabled}) {
          repository { id }
        }
      }
    GRAPHQL
    graphql(mutation, id: node_id, enabled:)
  end

  # -- rulesets ----------------------------------------------------------------

  def fetch_rulesets(repo)
    ids = get("repos/#{repo}/rulesets").map { it[:id] }
    rulesets = ids.map { get("repos/#{repo}/rulesets/#{it}").slice(*RULESET_FIELDS) }

    migrated = migrate_branch_protection(repo)
    rulesets << migrated if migrated

    rulesets
  rescue Octokit::Error => e
    abort "Error: failed to fetch rulesets from #{repo}: #{e.message}"
  end

  def apply_rulesets(repo, rulesets)
    rulesets ||= []
    if rulesets.empty?
      log "No rulesets to apply"
      return
    end

    rulesets.each do |rs|
      begin
        log "Creating ruleset: #{rs[:name]}"
        client.post("repos/#{repo}/rulesets", rs)
      rescue Octokit::UnprocessableEntity
        existing_id = find_ruleset_id(repo, rs[:name])
        raise if existing_id.nil?

        log "Ruleset #{rs[:name]} already exists on #{repo}, updating instead"
        client.put("repos/#{repo}/rulesets/#{existing_id}", rs)
      end
    rescue Octokit::Error => e
      warn "Warning: failed to apply ruleset #{rs[:name]} on #{repo}: #{e.message}"
    end
  end

  # There's no "update ruleset by name" endpoint -- only by id -- so a name
  # conflict on create means looking the existing one up first.
  def find_ruleset_id(repo, name)
    get("repos/#{repo}/rulesets").find { it[:name] == name }&.dig(:id)
  end

  # -- classic branch protection: read-only, migrated into a ruleset -------------
  #
  # Classic branch protection is deprecated in favor of rulesets, so this never
  # writes protection back -- it only reads the default branch's protection (if
  # any) and folds an equivalent ruleset into fetch_rulesets's result. Push
  # restrictions (an allow-list of who *can* push) have no ruleset equivalent
  # (rulesets express who's exempt, not who's allowed) and enforce_admins maps
  # to "no bypass actors" only approximately, so both are flagged rather than
  # guessed at.

  def migrate_branch_protection(repo)
    branch = get("repos/#{repo}")[:default_branch]
    protection = get("repos/#{repo}/branches/#{branch}/protection")
    ruleset_from_branch_protection(repo, branch, protection)
  rescue Octokit::NotFound, Octokit::BranchNotProtected
    warn "Warning: skipping branch protection migration on #{repo} (no protection on #{branch}, or lacks admin access)"
    nil
  end

  # `context` is only used to label warnings -- a live repo string when called
  # from migrate_branch_protection, or a filename when called from a merged
  # `branch_protection` file input (see merge_branch_protection!).
  def ruleset_from_branch_protection(context, branch, protection)
    rules = []

    if (sc = protection[:required_status_checks])
      rules << {
        type: "required_status_checks",
        parameters: {
          strict_required_status_checks_policy: sc[:strict] || false,
          required_status_checks: (sc[:checks] || []).map { {context: it[:context], integration_id: it[:app_id]}.compact }
        }
      }
    end

    if (pr = protection[:required_pull_request_reviews])
      rules << {
        type: "pull_request",
        parameters: {
          dismiss_stale_reviews_on_push: pr[:dismiss_stale_reviews] || false,
          require_code_owner_review: pr[:require_code_owner_reviews] || false,
          require_last_push_approval: pr[:require_last_push_approval] || false,
          required_approving_review_count: pr[:required_approving_review_count] || 0,
          required_review_thread_resolution: protection.dig(:required_conversation_resolution, :enabled) || false
        }
      }
    end

    rules << {type: "required_linear_history"} if protection.dig(:required_linear_history, :enabled)
    rules << {type: "required_signatures"} if protection.dig(:required_signatures, :enabled)
    rules << {type: "deletion"} unless protection.dig(:allow_deletions, :enabled)
    rules << {type: "non_fast_forward"} unless protection.dig(:allow_force_pushes, :enabled)

    return nil if rules.empty?

    if protection[:restrictions]
      warn "Warning: #{context}##{branch} branch protection has push restrictions -- not translatable to a ruleset, skipped"
    end

    unless protection.dig(:enforce_admins, :enabled)
      warn "Warning: #{context}##{branch} branch protection did not enforce for admins -- the migrated ruleset has no " \
           "bypass actors, so it WILL apply to admins too; review bypass_actors if that's not wanted"
    end

    {
      name: "Migrated from branch protection: #{branch}",
      target: "branch",
      enforcement: "active",
      bypass_actors: [],
      conditions: {ref_name: {include: ["refs/heads/#{branch}"], exclude: []}},
      rules:
    }
  end

  # -- labels ------------------------------------------------------------------

  def fetch_labels(repo)
    get("repos/#{repo}/labels").map { it.slice(:name, :color, :description) }
  rescue Octokit::Error => e
    abort "Error: failed to fetch labels from #{repo}: #{e.message}"
  end

  def apply_labels(repo, labels)
    labels ||= []
    if labels.empty?
      log "No labels to apply"
      return
    end

    log "Applying labels to #{repo}..."

    labels.each do |label|
      begin
        client.post("repos/#{repo}/labels", label)
      rescue Octokit::UnprocessableEntity
        client.patch("repos/#{repo}/labels/#{path_escape(label[:name])}", label.except(:name))
      end
    rescue Octokit::Error => e
      warn "Warning: failed to apply label #{label[:name]} to #{repo}: #{e.message}"
    end
  end

  # -- topics ------------------------------------------------------------------

  def fetch_topics(repo)
    get("repos/#{repo}/topics")[:names] || []
  rescue Octokit::Error => e
    abort "Error: failed to fetch topics from #{repo}: #{e.message}"
  end

  def apply_topics(repo, topics)
    log "Applying topics to #{repo}..."
    client.put("repos/#{repo}/topics", names: topics || [])
  rescue Octokit::Error => e
    abort "Error: failed to apply topics to #{repo}: #{e.message}"
  end

  # -- autolinks ---------------------------------------------------------------

  def fetch_autolinks(repo)
    get("repos/#{repo}/autolinks").map { it.slice(:key_prefix, :url_template, :is_alphanumeric) }
  rescue Octokit::NotFound
    warn "Warning: skipping autolinks on #{repo} (likely lacks admin access)"
    []
  rescue Octokit::Error => e
    abort "Error: failed to fetch autolinks from #{repo}: #{e.message}"
  end

  def apply_autolinks(repo, autolinks)
    autolinks ||= []
    if autolinks.empty?
      log "No autolinks to apply"
      return
    end

    log "Applying autolinks to #{repo}..."

    autolinks.each do |al|
      client.post("repos/#{repo}/autolinks", al)
    rescue Octokit::Error => e
      warn "Warning: failed to create autolink #{al[:key_prefix]} on #{repo}: #{e.message}"
    end
  end

  # -- actions permissions -------------------------------------------------------

  def fetch_actions_permissions(repo)
    perms = get("repos/#{repo}/actions/permissions")
    perms[:selected_actions] = get("repos/#{repo}/actions/permissions/selected-actions") if perms[:allowed_actions] == "selected"
    perms[:workflow_permissions] = get("repos/#{repo}/actions/permissions/workflow")
    perms
  rescue Octokit::NotFound
    warn "Warning: skipping actions permissions on #{repo} (likely lacks admin access)"
    {}
  rescue Octokit::Error => e
    abort "Error: failed to fetch actions permissions from #{repo}: #{e.message}"
  end

  def apply_actions_permissions(repo, perms)
    return if perms.nil? || perms.empty?

    log "Applying actions permissions to #{repo}..."
    perms = perms.dup
    selected = perms.delete(:selected_actions)
    workflow = perms.delete(:workflow_permissions)

    client.put("repos/#{repo}/actions/permissions", perms)
    client.put("repos/#{repo}/actions/permissions/selected-actions", selected) if selected
    client.put("repos/#{repo}/actions/permissions/workflow", workflow) if workflow
  rescue Octokit::Error => e
    abort "Error: failed to apply actions permissions to #{repo}: #{e.message}"
  end

  # -- actions variables -----------------------------------------------------------

  def fetch_actions_variables(repo)
    (get("repos/#{repo}/actions/variables")[:variables] || []).map { it.slice(:name, :value) }
  rescue Octokit::NotFound
    warn "Warning: skipping actions variables on #{repo} (likely lacks admin access)"
    []
  rescue Octokit::Error => e
    abort "Error: failed to fetch actions variables from #{repo}: #{e.message}"
  end

  def apply_actions_variables(repo, variables)
    variables ||= []
    if variables.empty?
      log "No actions variables to apply"
      return
    end

    log "Applying actions variables to #{repo}..."

    variables.each do |var|
      client.post("repos/#{repo}/actions/variables", var)
    rescue Octokit::UnprocessableEntity
      client.patch("repos/#{repo}/actions/variables/#{var[:name]}", value: var[:value])
    rescue Octokit::Error => e
      warn "Warning: failed to apply variable #{var[:name]} to #{repo}: #{e.message}"
    end
  end

  # -- collaborators (opt-in only: --only=collaborators -- grants access) --------

  def fetch_collaborators(repo)
    users =
      begin
        get("repos/#{repo}/collaborators", affiliation: "direct").map do |c|
          {login: c[:login], permission: highest_permission(c[:permissions])}
        end
      rescue Octokit::NotFound
        warn "Warning: skipping direct collaborators on #{repo} (likely lacks admin access)"
        []
      end

    teams =
      begin
        get("repos/#{repo}/teams").map do |t|
          {slug: t[:slug], permission: highest_permission(t[:permissions])}
        end
      rescue Octokit::NotFound
        warn "Warning: skipping team access on #{repo} (likely lacks admin access)"
        []
      end

    {users:, teams:, source_org: repo_org(repo)}
  rescue Octokit::Error => e
    abort "Error: failed to fetch collaborators from #{repo}: #{e.message}"
  end

  def apply_collaborators(repo, data)
    users = data[:users] || []
    teams = data[:teams] || []

    if users.empty? && teams.empty?
      log "No collaborators to apply"
      return
    end

    target_org = repo_org(repo)

    log "Applying collaborators to #{repo}..."

    users.each do |u|
      client.put("repos/#{repo}/collaborators/#{u[:login]}", permission: u[:permission])
    rescue Octokit::Error => e
      warn "Warning: failed to add collaborator #{u[:login]} to #{repo}: #{e.message}"
    end

    teams.each do |t|
      if data[:source_org] != target_org
        warn "Warning: skipping team @#{data[:source_org]}/#{t[:slug]} - #{repo} is in a different org (#{target_org})"
        next
      end

      client.put("orgs/#{target_org}/teams/#{t[:slug]}/repos/#{repo}", permission: t[:permission])
    rescue Octokit::Error => e
      warn "Warning: failed to grant team #{t[:slug]} access to #{repo}: #{e.message}"
    end
  end

  # -- environments (opt-in only: --only=environments -- reviewers grant access) --

  def fetch_environments(repo)
    envs = get("repos/#{repo}/environments")[:environments] || []
    source_org = repo_org(repo)

    envs.map do |env|
      rules = env[:protection_rules] || []
      wait_timer = rules.find { it[:type] == "wait_timer" }&.dig(:wait_timer) || 0
      reviewers = rules.select { it[:type] == "required_reviewers" }
        .flat_map { it[:reviewers] || [] }
        .map { {type: it[:type], id: it.dig(:reviewer, :id)} }

      {
        name: env[:name],
        wait_timer:,
        reviewers:,
        deployment_branch_policy: env[:deployment_branch_policy],
        source_org:
      }
    end
  rescue Octokit::Error => e
    abort "Error: failed to fetch environments from #{repo}: #{e.message}"
  end

  def apply_environments(repo, envs)
    envs ||= []
    if envs.empty?
      log "No environments to apply"
      return
    end

    target_org = repo_org(repo)

    envs.each do |env|
      reviewers = (env[:reviewers] || []).filter_map do |r|
        next {id: r[:id]} if r[:type] == "User"
        next nil if env[:source_org] != target_org

        {id: r[:id]}
      end

      body = {
        wait_timer: env[:wait_timer],
        reviewers:,
        deployment_branch_policy: env[:deployment_branch_policy]
      }

      log "Creating environment: #{env[:name]}"
      client.put("repos/#{repo}/environments/#{path_escape(env[:name])}", body)
    rescue Octokit::Error => e
      warn "Warning: failed to create environment #{env[:name]} on #{repo}: #{e.message}"
    end
  end

  # -- modes -------------------------------------------------------------------

  def mode_copy(args)
    args, resources = extract_resource_filter(args)
    from, to = resolve_from_to(args)

    collected = collect(from)
    resources.each { |res| send(:"apply_#{res}", to, collected[res]) }

    log "Done!"
  end

  def mode_save(args)
    args = parse_options!(args)
    usage(1) if args.length > 2

    from, file =
      case args.length
      when 0
        f = require_repo(".")
        [f, "#{f.tr("/", "-")}.json"]
      when 1
        if (candidate = resolve_repo(args[0]))
          [candidate, "#{candidate.tr("/", "-")}.json"]
        else
          [require_repo("."), args[0]]
        end
      when 2
        [require_repo(args[0]), args[1]]
      end

    json = JSON.pretty_generate(collect(from))

    if file == "-"
      puts json
    else
      File.write(file, json)
      log "Settings saved to #{file}"
    end
  end

  def mode_apply(args)
    args, resources = extract_resource_filter(args)
    usage(1) if args.empty?

    if (candidate = resolve_repo(args[0]))
      target = candidate
      args = args[1..]
    else
      target = require_repo(".")
    end

    usage(1) if args.empty?

    combined = merge_skeleton(resources)
    args.each { |file| merge_file_into!(combined, file) }

    resources.each { |res| send(:"apply_#{res}", target, combined[res]) }

    log "Done!"
  end

  # Undocumented: the logical equivalent of `apply base o1 o2 o3` applying
  # multiple times, minus the actual application -- prints the merged result
  # (to stdout by default, or -O/--output=FILE) instead of hitting a repo.
  # Also accepts {branch_protection: {...}} input (see merge_branch_protection!).
  def mode_merge(args)
    output = nil

    args, resources = extract_resource_filter(args) do |parser|
      parser.on("-O", "--output=FILE", "Write merged JSON to FILE instead of stdout") { |f| output = f }
    end

    usage(1) if args.empty?

    combined = merge_skeleton(resources)
    args.each { |file| merge_file_into!(combined, file) }

    json = JSON.pretty_generate(combined)

    if output
      File.write(output, json)
      log "Merged output written to #{output}"
    else
      puts json
    end
  end
end

RepoTool.new.run(ARGV)
