#!/usr/bin/env bash
#
# An enhanced git-pull that shows a short log of changes immediately after
# merging (git-up) or rebasing (git-reup or git-up --rebase). Submodules are
# quietly recursively updated.
#
# If the current repository is a fork (see git-fork), the fork is synced with
# its parent on the hosting service before fetching.
#
# Inspired by Kyle Neath's `git up' alias <http://gist.github.com/249223> and
# based on git-up by Ryan Tomayko
# <http://github.com/rtomayko/dotfiles/blob/rtomayko/bin/git-up>.

set -uo pipefail

bn0="$(basename "${0}")"
readonly bn0

usage() {
  cat <<USAGE
Usage: ${bn0} [options]

An enhanced git-pull that shows a short log of changes immediately after
merging (git-up) or rebasing (git-reup or git-up --rebase). Submodules are
quietly recursively updated.

If the current repository is a fork and git-fork is available, the fork is
synced with its parent on the hosting service prior to fetching, and the
parent's remote is the authority for tags that have been moved (such as 'v1'
following 'v1.2.3'). When there is no parent remote, the remote named by the
string config 'git-up.prefer-tags-from' is used instead; without either, each
remote updates moved tags in alphabetical order, so the last one wins.

All other options and parameters are passed to 'git-pull'.

Options

  -r, --rebase                Use a rebase flow. This is the default when called
  -R, --no-rebase             as 'git-reup'.
                              Boolean config 'git-up.rebase'.

  -m, --sync-fork             Sync the fork with its parent with 'git fork sync'.
  -M, --no-sync-fork          Enabled by default.
                              Boolean config 'git-up.sync-fork'.

  -s, --submodule-update      Updates submodules. Enabled by default.
  -S, --no-submodule-update   Boolean config 'git-up.submodule-update'.

USAGE
}

halt-error() {
  echo >&2 "${bn0}: $*"
  exit 1
}

git rev-parse --is-inside-work-tree 2>/dev/null 1>/dev/null ||
  halt-error "${PWD} is not a git working tree"

declare -a remotes args
declare rebase submodule_update sync_fork tag_remote
args=()
tag_remote=

# Sorted so that when no remote is the tag authority (no fork parent and no
# git-up.prefer-tags-from), the last remote alphabetically wins for moved tags.
# shellcheck disable=SC2312
readarray -t remotes < <(git remote | LC_ALL=C sort)

rebase=$(git config --get --type=bool git-up.rebase)
submodule_update=$(git config --get --type=bool git-up.submodule-update)
sync_fork=$(git config --get --type=bool git-up.sync-fork)

if [[ -z "${rebase}" ]]; then
  if [[ "${bn0}" == git-reup ]]; then
    rebase=true
  else
    rebase=false
  fi
fi

[[ -z "${submodule_update}" ]] && submodule_update=true
[[ -z "${sync_fork}" ]] && sync_fork=true

while (($#)); do
  case "${1}" in
  -h | --help)
    usage
    exit 0
    ;;
  -R | --no-rebase) rebase=false ;;
  -r | --rebase) rebase=true ;;
  -m | --sync-fork) sync_fork=true ;;
  -M | --no-sync-fork) sync_fork=false ;;
  -s | --submodule-update) submodule_update=true ;;
  -S | --no-submodule-update) submodule_update=false ;;
  *) args+=("${1}") ;;
  esac
  shift
done

set -- "${args[@]}"

# git-fork caches the parent lookup in local config, so this only touches the
# network the first time (and for the sync itself).
if command -v git-fork >/dev/null 2>&1 && git fork is-fork 2>/dev/null; then
  "${sync_fork}" && git fork sync
  tag_remote="$(git fork source-remote 2>/dev/null)"
fi

if [[ -z "${tag_remote}" ]]; then
  tag_remote="$(git config --get git-up.prefer-tags-from)"

  if [[ -n "${tag_remote}" ]] && ! git remote get-url "${tag_remote}" >/dev/null 2>&1; then
    echo >&2 "${bn0}: git-up.prefer-tags-from remote '${tag_remote}' does not exist; ignored"
    tag_remote=
  fi
fi

# Fetch a remote with prune. Tags that have been moved on the remote (mutable
# tags like `v1` or `v1.2`) are rejected as "would clobber existing tag" when
# fetch.pruneTags or --tags is in effect; those are force-updated from the
# remote and the fetch is retried. If force_tags is false, moved tags are left
# alone and the remote is fetched without tags instead.
fetch-remote() {
  local remote force_tags output
  local -a tags refspecs
  remote="${1}"
  force_tags="${2:-true}"

  output="$(git fetch --prune "${remote}" 2>&1)" && return 0

  # shellcheck disable=SC2312
  readarray -t tags < <(
    sed -nE 's/^ ! \[rejected\] +([^ ]+) +-> +[^ ]+ +\(would clobber existing tag\)$/\1/p' <<<"${output}"
  )

  if ((${#tags[@]} == 0)); then
    echo >&2 "${output}"
    return 1
  fi

  if ! "${force_tags}"; then
    git -c fetch.pruneTags=false fetch --prune --quiet --no-tags "${remote}"
    return
  fi

  refspecs=("${tags[@]/#/+refs/tags/}")
  for i in "${!tags[@]}"; do
    refspecs[i]="${refspecs[i]}:refs/tags/${tags[i]}"
  done

  if git fetch --quiet --no-tags "${remote}" "${refspecs[@]}" &&
    git fetch --prune --quiet "${remote}"; then
    echo "Updated tags from ${remote}: ${tags[*]}"
  else
    echo >&2 "${output}"
    return 1
  fi
}

# The tag authority (a fork's parent, or git-up.prefer-tags-from) is the only
# remote allowed to move tags; a fork that hasn't synced tags must not revert
# them. It is fetched last because fetch.pruneTags on the other remotes prunes
# tags that only it has.
for remote in "${remotes[@]}"; do
  if [[ -z "${tag_remote}" ]]; then
    fetch-remote "${remote}"
  elif [[ "${remote}" != "${tag_remote}" ]]; then
    fetch-remote "${remote}" false
  fi
done

[[ -n "${tag_remote}" ]] && fetch-remote "${tag_remote}"

# when invoked as git-reup, run as `git pull --rebase'
"${rebase}" && set -- --rebase "${@}"

# Tags were handled above; keep pull's own fetch from tripping over them again
# (fetch.pruneTags adds a non-forced tag refspec that --no-tags doesn't remove).
git -c fetch.pruneTags=false pull --no-tags "${@}"
echo

# show diffstat of all changes if we're pulling with --rebase. not
# sure why git-pull only does this when merging.
"${rebase}" && {
  declare diff
  diff=$(git --no-pager diff --color --stat "HEAD@{1}.." | sed 's/^/ /')

  [[ -z "${diff}" ]] || printf "Diff:\n%s\n\n" "${diff}"
}

# show an abbreviated commit log of stuff that was just merged.
{
  declare log
  log=$(git log --color --pretty=oneline --abbrev-commit "HEAD@{1}.." | sed 's/^/  /')
  [[ -z "${log}" ]] || printf "Log:\n%s\n\n" "${log}"
}

echo "Branches:"
git branch -vv

"${submodule_update}" && {
  # Update any submodules
  git submodule --quiet update --init --recursive
}
