#!/usr/bin/env python3
# ruff: noqa: BLE001

import os
import sqlite3
import sys

if len(sys.argv) != 4:
    print(
        'Usage: python3 safari_extract.py "<SQL query>" <db-path> <output-path>',
        file=sys.stderr,
    )
    sys.exit(2)

query, db_path, out_path = (
    sys.argv[1],
    os.path.expanduser(sys.argv[2]),
    os.path.expanduser(sys.argv[3]),
)

conn = sqlite3.connect(db_path)
cur = conn.cursor()
try:
    cur.execute(query)
except Exception as e:
    print(f"SQL error: {e}", file=sys.stderr)
    conn.close()
    sys.exit(1)

seen = set()
with open(out_path, "w", encoding="utf-8") as f:
    for row in cur:
        # Expecting at least two columns: title, url (but handle variable results)
        title = (row[0] if len(row) > 0 and row[0] is not None else "").strip()
        url = (row[1] if len(row) > 1 and row[1] is not None else "").strip()
        if not url:
            continue
        title = title.replace("]", "\\]")
        if url in seen:
            continue
        seen.add(url)
        f.write(f"- [{title}]({url})\n")

conn.close()
