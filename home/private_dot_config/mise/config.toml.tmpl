{{- $work := has "work" (get . "roles" | default list) -}}
{{- $env := dict
  "ERL_AFLAGS"          "-kernel shell_history enabled shell_history_file_bytes 5242880"
  "RIPGREP_CONFIG_PATH" (joinPath .chezmoi.homeDir ".ripgreprc")
-}}
{{- $tools := dict
  "aqua:kjanat/actionlint"        "1.17"
  "elixir"                        (dict
                                    "version" "1.20.5-otp-29"
                                    "postinstall" "mix do local.hex --force + local.rebar --force"
                                  )
  "erlang"                        "29.1"
  "github:hay-kot/scaffold"       "latest"
  "github:middlendian/llima-box"  "latest"
  "github:KarnerTh/mermerd"       "latest"
  "gleam"                         "latest"
  "go"                            "1.27"
  "go:golang.org/x/tools/gopls"   "latest"
  "opentofu"                      "latest"
  "node"                          (dict
                                    "version" "24"
                                    "postinstall" "corepack enable"
                                  )
  "ruby"                          "4.0"
  "rust"                          "1.99"
  "rumdl"                         "latest"
  "shellcheck"                    "latest"
  "shfmt"                         "latest"
  "usage"                         "latest"
  "vacuum"                        "latest"
  "zig"                           "0.17"
-}}

{{- if $work -}}
{{-   $_ := set $tools "aws-vault"                          "7" -}}
{{-   $_ := set $tools "foundry"                            "latest" -}}
{{- /*   $_ := set $tools "github:anza-xyz/agave"              "latest"  */ -}}
{{- /*   $_ := set $tools "github:geofffranks/spruce"          "latest"  */ -}}
{{-   $_ := set $tools "github:telia-oss/aws-env"           "latest" -}}
{{-   $_ := set $tools "go:newreleases.io/cmd/newreleases"  "latest" -}}
{{-   $_ := set $tools "jsonschema"                         "latest" -}}
{{-   $_ := set $tools "k9s"                                "latest" -}}
{{-   $_ := set $tools "kubectl"                            "latest" -}}
{{-   $_ := set $tools "vacuum"                             "latest" -}}

{{- end -}}

min_version = { soft = "2026.11.9", hard = "2026.11.4" }

[settings]
always_keep_install = false
experimental = true
idiomatic_version_file = false
legacy_version_file = false
paranoid = {{ not $work | toToml }}

{{ dict "env" $env | toToml }}
{{ dict "tools" $tools | toToml }}
