{{- /* Return a map of 1Password accounts selected in `.op`. */ -}}
{{- $accounts :=
  includeTemplate "1p/accounts/list" .
  | fromJson
  | jq "map({ (.url) : . }) | add"
  | first
-}}
{{- $res := dict -}}
{{- range $_, $url := .op }}{{ $res = merge $res (pick $accounts $url) }}{{ end -}}
{{- toJson $res -}}
