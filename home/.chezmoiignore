{{ if lookPath "uv" -}}
{{/* uv-managed files in ~/.local/bin */}}
{{-   $uv := output "uv" "tool" "list" "--show-paths" }}
{{-   range $line := splitList "\n" $uv }}
{{-     if hasPrefix "- " $line }}
{{       mustRegexReplaceAll "^- [^ ]+ [(](.+)[)]" $line "$1" |
             trimPrefix $.chezmoi.homeDir |
             trimPrefix "/" }}
{{-     end }}
{{-   end }}
{{- end }}

